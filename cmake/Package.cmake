# =============================================================================
# Prebuilt-engine package (build-tree export).
#
# Writes VulkanEngineConfig.cmake + VulkanEngineTargets.cmake into this build
# folder, so a game can link the engine compiled here instead of building it:
#
#   # game CMakeLists.txt (configure with -DVulkanEngine_DIR=<this build folder>)
#   find_package(VulkanEngine REQUIRED)
#   add_executable(mygame src/main.cpp)
#   ve_setup_game(mygame ASSETS ${CMAKE_CURRENT_SOURCE_DIR}/assets SHADERS ${MY_SHADERS})
#
# The game gets imported targets ve::ve_engine / ve::ve_effects (with every
# static library they need), the engine's compiled shaders copied into its own
# bin/shaders, and the usual ve_setup_game() / ve_compile_shaders() helpers.
#
# It is a *build-tree* package: headers come from this checkout and libraries
# from this build folder, so rebuilding the engine here is all it takes for
# games to pick up engine changes (they relink on their next build).
#
# Use a game build type that matches this folder's (Debug game -> Debug engine
# build), and the same compiler (MinGW GCC vs MSVC libraries don't mix).
# =============================================================================

include(PackageUtils)

_ve_link_closure(_ve_export_targets ve_engine ve_effects)
export(TARGETS ${_ve_export_targets}
    NAMESPACE ve::
    FILE "${CMAKE_BINARY_DIR}/VulkanEngineTargets.cmake")

get_property(VE_PACKAGE_ENGINE_SHADERS GLOBAL PROPERTY VE_SHADER_OUTPUTS_ve_engine)
get_property(VE_PACKAGE_EFFECTS_SHADERS GLOBAL PROPERTY VE_SHADER_OUTPUTS_ve_effects)
set(VE_PACKAGE_BUILD_TYPE "${CMAKE_BUILD_TYPE}")
set(VE_PACKAGE_COMPILER_ID "${CMAKE_CXX_COMPILER_ID}")
set(VE_PACKAGE_SOURCE_DIR "${PROJECT_SOURCE_DIR}")
set(VE_PACKAGE_BINARY_DIR "${CMAKE_BINARY_DIR}")
# The system's SDL2 / glm (when found instead of built here): games find them too.
set(VE_PACKAGE_SYSTEM_SDL2 OFF)
if(SDL2_FOUND)
    set(VE_PACKAGE_SYSTEM_SDL2 ON)
endif()
set(VE_PACKAGE_SYSTEM_GLM OFF)
if(glm_FOUND)
    set(VE_PACKAGE_SYSTEM_GLM ON)
endif()

file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/VulkanEngineConfig.cmake" @ONLY CONTENT [=[
# Generated by vulkan-engine (cmake/Package.cmake). Do not edit.
# Prebuilt engine from @VE_PACKAGE_BINARY_DIR@
if(TARGET ve::ve_engine)
    return()
endif()

set(VulkanEngine_VERSION "@PROJECT_VERSION@")
set(VulkanEngine_SOURCE_DIR "@VE_PACKAGE_SOURCE_DIR@")
set(VulkanEngine_BINARY_DIR "@VE_PACKAGE_BINARY_DIR@")
set(VulkanEngine_BUILD_TYPE "@VE_PACKAGE_BUILD_TYPE@")

if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "@VE_PACKAGE_COMPILER_ID@")
    message(FATAL_ERROR "VulkanEngine at ${VulkanEngine_BINARY_DIR} was built with @VE_PACKAGE_COMPILER_ID@, "
                        "this project uses ${CMAKE_CXX_COMPILER_ID}: the libraries can't be mixed.")
endif()
if(VulkanEngine_BUILD_TYPE AND CMAKE_BUILD_TYPE AND NOT CMAKE_BUILD_TYPE STREQUAL VulkanEngine_BUILD_TYPE)
    message(WARNING "Linking a ${VulkanEngine_BUILD_TYPE} engine build (${VulkanEngine_BINARY_DIR}) "
                    "into a ${CMAKE_BUILD_TYPE} game. Point VulkanEngine_DIR at a ${CMAKE_BUILD_TYPE} engine build.")
endif()

set(VE_PREBUILT_ENGINE_SHADERS "@VE_PACKAGE_ENGINE_SHADERS@")
set(VE_PREBUILT_EFFECTS_SHADERS "@VE_PACKAGE_EFFECTS_SHADERS@")
list(GET VE_PREBUILT_ENGINE_SHADERS 0 _ve_first_spv)
if(NOT EXISTS "${_ve_first_spv}")
    message(FATAL_ERROR "VulkanEngine at ${VulkanEngine_BINARY_DIR} hasn't been built yet. "
                        "Build it once: cmake --build \"${VulkanEngine_BINARY_DIR}\"")
endif()

include(CMakeFindDependencyMacro)
find_dependency(Vulkan COMPONENTS glslc)
find_dependency(Threads)
if(@VE_PACKAGE_SYSTEM_SDL2@)
    find_dependency(SDL2 CONFIG)
endif()
if(@VE_PACKAGE_SYSTEM_GLM@)
    find_dependency(glm CONFIG)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/VulkanEngineTargets.cmake")

# What ve_setup_game() / ve_compile_shaders() expect: everything goes to the
# game's own <build>/bin (executable, shaders/, assets/).
set(VE_OUTPUT_DIR "${CMAKE_BINARY_DIR}/bin")
set(VE_SHADER_OUTPUT_DIR "${VE_OUTPUT_DIR}/shaders")
set(VE_ENGINE_SHADER_INCLUDE "${VulkanEngine_SOURCE_DIR}/engine/shaders/include")
set(VE_EFFECTS_SHADER_INCLUDE "${VulkanEngine_SOURCE_DIR}/effects/shaders/include")
include("${VulkanEngine_SOURCE_DIR}/cmake/Shaders.cmake")
include("${VulkanEngine_SOURCE_DIR}/cmake/Game.cmake")
set(VulkanEngine_FOUND TRUE)
]=])

include(CMakePackageConfigHelpers)
write_basic_package_version_file("${CMAKE_BINARY_DIR}/VulkanEngineConfigVersion.cmake"
    VERSION ${PROJECT_VERSION}
    COMPATIBILITY SameMinorVersion)
