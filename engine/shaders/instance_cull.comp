#version 460
// GPU instance culling.
//
// One thread per instance of one InstanceGroup. The thread loads the instance
// and computes its bounding sphere and LOD (from the distance to the camera, so
// all views agree) once, then tests every view (0 = camera, then directional
// shadow cascades). For every view it survives (distance, size, frustum), it
// appends the instance to the visible list of each of that LOD's draw
// batches, bumping the batch's indirect draw instanceCount with an atomic.
//
// The draw passes then issue vkCmdDrawIndexedIndirect per batch; the vertex
// shader maps gl_InstanceIndex -> veVisibleInstances[] -> veInstances[].
//
// LOD metric: screen-size mode = projected radius / distance (fraction of half
// the screen height), distance mode = 1 / distance. LOD i is used while the
// metric >= lodThresholds[i]. Near a threshold the instance is emitted into
// BOTH LODs with complementary dither masks (crossfade, no popping).
//
// Occlusion (camera only, RendererSettings::occlusionCulling): the instance's
// bounding box, projected with last frame's camera, is compared with last
// frame's depth pyramid (HiZPass) at the level where it covers <= 2x2 texels.
// If its nearest point is behind the farthest depth there, it is hidden.
//
// Visible entry encoding: bits 0-22 instance index, 23-30 fade (0..255),
// bit 31 = 1 for the incoming (next-LOD) copy. See ve.glsl.
#define VE_CUSTOM_PUSH_CONSTANTS
#include "ve.glsl"

layout(local_size_x = 64) in;

struct Instance {
    vec4 rows[3];
    vec4 custom;
};

struct Group {
    vec4 localSphere;
    vec4 lodDistances;
    uvec4 lodBatchStart;
    uvec4 lodBatchCount;
    uint firstInstance;
    uint count;
    uint lodCount;
    uint flags;
    float cullDistance;
    float shadowDistance;
    uint pad0, pad1;
};

struct CullView {
    vec4 planes[6];
    vec4 position;
};

// Same layout as VkDrawIndexedIndirectCommand.
struct DrawCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
};

layout(set = 0, binding = 5, std430) readonly buffer Instances { Instance instances[]; };
layout(set = 0, binding = 6, std430) writeonly buffer Visible { uint visible[]; };
layout(set = 0, binding = 7, std430) buffer Commands { DrawCommand commands[]; };
layout(set = 0, binding = 8, std430) readonly buffer Groups { Group groups[]; };
layout(set = 0, binding = 9, std430) readonly buffer Views { CullView views[]; };

layout(push_constant) uniform Push {
    uint groupIndex;
    uint batchCount;     // batches per view (commands are [view][batch])
    float lodScale;      // 1 / tan(fovY / 2)
    float lodBias;       // metric multiplier: > 1 = more detail
    uint shadowLodBias;  // shadow views use LOD + this
    float fadeBand;      // crossfade width, as a fraction of the threshold
    uint viewCount;      // camera + shadow cascades
    uint hizValid;       // 1 = occlusion test against hiz[]
    uint hiz[10];        // last frame's depth pyramid, 512x256 .. 1x1 (bindless)
} pc;

bool occluded(vec3 centre, float radius)
{
    if (pc.hizValid == 0u) return false;
    vec2 lo = vec2(1e9), hi = vec2(-1e9);
    float nearest = 0.0; // reversed-Z: larger = closer
    for (int i = 0; i < 8; ++i) {
        vec3 corner = centre + radius * vec3((i & 1) != 0 ? 1.0 : -1.0, (i & 2) != 0 ? 1.0 : -1.0, (i & 4) != 0 ? 1.0 : -1.0);
        vec4 clip = frame.prevViewProj * vec4(corner, 1.0);
        if (clip.w <= 1e-3) return false; // reaches behind last frame's camera
        vec3 ndc = clip.xyz / clip.w;
        lo = min(lo, ndc.xy);
        hi = max(hi, ndc.xy);
        nearest = max(nearest, ndc.z);
    }
    vec2 uvLo = lo * 0.5 + 0.5, uvHi = hi * 0.5 + 0.5;
    // Off screen last frame: nothing known about what hides it.
    if (any(lessThan(uvLo, vec2(0.0))) || any(greaterThan(uvHi, vec2(1.0)))) return false;
    vec2 extent = (uvHi - uvLo) * vec2(512.0, 256.0);
    uint level = min(uint(ceil(log2(max(max(extent.x, extent.y), 1.0)))), 9u);
    ivec2 dim = max(ivec2(512, 256) >> int(level), ivec2(1));
    ivec2 a = clamp(ivec2(uvLo * vec2(dim)), ivec2(0), dim - 1);
    ivec2 b = clamp(ivec2(uvHi * vec2(dim)), ivec2(0), dim - 1);
    uint t = pc.hiz[level];
    float farthest = min(min(texelFetch(veTextures[nonuniformEXT(t)], a, 0).r, texelFetch(veTextures[nonuniformEXT(t)], ivec2(b.x, a.y), 0).r),
                         min(texelFetch(veTextures[nonuniformEXT(t)], ivec2(a.x, b.y), 0).r, texelFetch(veTextures[nonuniformEXT(t)], b, 0).r));
    return nearest < farthest;
}

void emit(uint view, uint first, uint count, uint entry)
{
    for (uint b = first; b < first + count; ++b) {
        uint cmd = view * pc.batchCount + b;
        uint slot = atomicAdd(commands[cmd].instanceCount, 1u);
        // firstInstance already points at this batch's region of the visible list.
        visible[commands[cmd].firstInstance + slot] = entry;
    }
}

// Sphere vs. a view: big enough to matter there (e.g. a bush in a far shadow
// cascade covering less than ~2 shadow texels doesn't), and inside the frustum.
bool visibleIn(uint view, vec3 centre, float radius)
{
    CullView v = views[view];
    if (radius < v.position.w) return false;
    for (int p = 0; p < 6; ++p) {
        if (dot(v.planes[p].xyz, centre) + v.planes[p].w < -radius) return false;
    }
    return true;
}

void main()
{
    Group g = groups[pc.groupIndex];
    uint local = gl_GlobalInvocationID.x;
    if (local >= g.count) return;

    uint index = g.firstInstance + local;
    Instance inst = instances[index];
    // World-space bounding sphere: transform the centre, scale the radius by the largest axis scale.
    vec3 c = g.localSphere.xyz;
    vec3 centre = vec3(dot(inst.rows[0].xyz, c) + inst.rows[0].w,
                       dot(inst.rows[1].xyz, c) + inst.rows[1].w,
                       dot(inst.rows[2].xyz, c) + inst.rows[2].w);
    vec3 sx = vec3(inst.rows[0].x, inst.rows[1].x, inst.rows[2].x);
    vec3 sy = vec3(inst.rows[0].y, inst.rows[1].y, inst.rows[2].y);
    vec3 sz = vec3(inst.rows[0].z, inst.rows[1].z, inst.rows[2].z);
    float radius = g.localSphere.w * sqrt(max(dot(sx, sx), max(dot(sy, sy), dot(sz, sz))));

    float dist = distance(centre, views[0].position.xyz);
    if (dist - radius > g.cullDistance) return;

    bool screenSize = (g.flags & 2u) != 0u;
    float metric = (screenSize ? radius * pc.lodScale / max(dist, 1e-3) : 1.0 / max(dist, 1e-3)) * pc.lodBias;
    uint lod = 0u;
    while (lod + 1u < g.lodCount && metric < g.lodDistances[lod]) ++lod;

    // --- Camera -----------------------------------------------------------------
    if (visibleIn(0u, centre, radius) && !occluded(centre, radius)) {
        // Crossfade: f = 0 well above the threshold -> 1 right at it.
        uint q = 0u;
        if (lod + 1u < g.lodCount && pc.fadeBand > 0.0) {
            float thr = g.lodDistances[lod];
            float f = clamp(1.0 - (metric - thr) / max(thr * pc.fadeBand, 1e-6), 0.0, 1.0);
            q = uint(f * 255.0 + 0.5);
        }
        if (q == 0u) {
            emit(0u, g.lodBatchStart[lod], g.lodBatchCount[lod], index);
        } else {
            emit(0u, g.lodBatchStart[lod], g.lodBatchCount[lod], index | (q << 23));                  // fading out
            emit(0u, g.lodBatchStart[lod + 1u], g.lodBatchCount[lod + 1u], index | (q << 23) | (1u << 31)); // fading in
        }
    }

    // --- Shadow cascades: coarser LOD, no crossfade (depth-only shaders can't dither)
    if ((g.flags & 1u) == 0u || dist - radius > g.shadowDistance) return;
    uint shadowLod = min(lod + pc.shadowLodBias, g.lodCount - 1u);
    for (uint view = 1u; view < pc.viewCount; ++view) {
        if (visibleIn(view, centre, radius)) emit(view, g.lodBatchStart[shadowLod], g.lodBatchCount[shadowLod], index);
    }
}
