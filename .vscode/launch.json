{
    // F5 configurations. Each builds first, then runs the savanna test scene under
    // gdb (Linux) or the Visual Studio debugger (Windows: the "windows" blocks;
    // needs the C/C++ extension and Visual Studio 2022 or its Build Tools).
    //  - Sandbox:     the game (Debug: no optimisation, Vulkan validation ON - watch the
    //                 terminal for [vulkan] messages; Release: optimised, validation OFF)
    //  - Editor:      the same scene, starting in the in-engine editor (SAVANNA_EDITOR=1;
    //                 F2 toggles editor <-> game in any configuration)
    //  - Autotest / Editor test: scripted smoke tests that exit by themselves
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Sandbox (Debug)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/savanna",
            "cwd": "${workspaceFolder}/build/bin",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [{ "text": "-enable-pretty-printing", "ignoreFailures": true }],
            "preLaunchTask": "Build Debug",
            "windows": { "type": "cppvsdbg", "program": "${workspaceFolder}/build/bin/savanna.exe", "console": "integratedTerminal" }
        },
        {
            "name": "Sandbox (Release)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-release/bin/savanna",
            "cwd": "${workspaceFolder}/build-release/bin",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [{ "text": "-enable-pretty-printing", "ignoreFailures": true }],
            "preLaunchTask": "Build Release",
            "windows": { "type": "cppvsdbg", "program": "${workspaceFolder}/build-release/bin/savanna.exe", "console": "integratedTerminal" }
        },
        {
            "name": "Editor (Debug)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/savanna",
            "cwd": "${workspaceFolder}/build/bin",
            "environment": [{ "name": "SAVANNA_EDITOR", "value": "1" }],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [{ "text": "-enable-pretty-printing", "ignoreFailures": true }],
            "preLaunchTask": "Build Debug",
            "windows": { "type": "cppvsdbg", "program": "${workspaceFolder}/build/bin/savanna.exe", "console": "integratedTerminal" }
        },
        {
            "name": "Editor (Release)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-release/bin/savanna",
            "cwd": "${workspaceFolder}/build-release/bin",
            "environment": [{ "name": "SAVANNA_EDITOR", "value": "1" }],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [{ "text": "-enable-pretty-printing", "ignoreFailures": true }],
            "preLaunchTask": "Build Release",
            "windows": { "type": "cppvsdbg", "program": "${workspaceFolder}/build-release/bin/savanna.exe", "console": "integratedTerminal" }
        },
        {
            "name": "Autotest (Debug)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/savanna",
            "cwd": "${workspaceFolder}/build/bin",
            "environment": [{ "name": "SAVANNA_AUTOTEST", "value": "1" }],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [{ "text": "-enable-pretty-printing", "ignoreFailures": true }],
            "preLaunchTask": "Build Debug",
            "windows": { "type": "cppvsdbg", "program": "${workspaceFolder}/build/bin/savanna.exe", "console": "integratedTerminal" }
        },
        {
            "name": "Editor test (Debug)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/savanna",
            "cwd": "${workspaceFolder}/build/bin",
            "environment": [{ "name": "SAVANNA_EDITORTEST", "value": "1" }],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [{ "text": "-enable-pretty-printing", "ignoreFailures": true }],
            "preLaunchTask": "Build Debug",
            "windows": { "type": "cppvsdbg", "program": "${workspaceFolder}/build/bin/savanna.exe", "console": "integratedTerminal" }
        }
    ]
}
