{
    // IntelliSense: uses CMake's compile_commands.json (exact flags/includes per
    // file, including fetched third-party headers). The includePath below is a
    // fallback until the first build.
    "configurations": [
        {
            "name": "Linux",
            "compileCommands": "${workspaceFolder}/build/compile_commands.json",
            "compilerPath": "/usr/bin/g++",
            "cStandard": "c17",
            "cppStandard": "c++20",
            "intelliSenseMode": "linux-gcc-x64",
            "includePath": [
                "${workspaceFolder}/engine/src",
                "${workspaceFolder}/effects/src",
                "${workspaceFolder}/sandbox/src",
                "${workspaceFolder}/build/_deps/**",
                "/usr/include/SDL2",
                "/usr/include"
            ],
            "defines": ["GLM_FORCE_RADIANS", "GLM_FORCE_DEPTH_ZERO_TO_ONE", "GLM_ENABLE_EXPERIMENTAL", "SDL_MAIN_HANDLED"]
        }
    ],
    "version": 4
}
