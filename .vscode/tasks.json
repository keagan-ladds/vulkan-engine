{
    // Build tasks used by launch.json (preLaunchTask) and Ctrl+Shift+B (Debug).
    // "Build X" first runs "Configure X" (re-globbing new source/shader files),
    // then builds. Same toolchain on both OSes: CMake + Ninja + GCC.
    //  - Linux:   the system compiler (g++).
    //  - Windows: MinGW-w64 GCC (e.g. w64devkit: gcc, g++, cmake, ninja, gdb on
    //             PATH) plus the Vulkan SDK. The compilers are named so CMake
    //             doesn't pick Visual Studio's cl.exe.
    //  - "MSVC" tasks (Windows): Visual Studio 2022's compiler via the vs2022
    //             CMake preset, in build-vs/ (Debug and Release share
    //             build-vs/bin: whichever was built last is there). No developer
    //             prompt needed: CMake finds Visual Studio itself.
    // Tasks run cmake directly (no shell), so any default terminal works.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure Debug",
            "type": "process",
            "command": "cmake",
            "args": ["-S", ".", "-B", "build", "-G", "Ninja", "-DCMAKE_BUILD_TYPE=Debug"],
            "windows": {
                "args": ["-S", ".", "-B", "build", "-G", "Ninja", "-DCMAKE_BUILD_TYPE=Debug",
                         "-DCMAKE_C_COMPILER=gcc", "-DCMAKE_CXX_COMPILER=g++"]
            },
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "Build Debug",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "build"],
            "dependsOn": "Configure Debug",
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": { "base": "$gcc", "fileLocation": ["autoDetect", "${workspaceFolder}/build"] }
        },
        {
            "label": "Configure Release",
            "type": "process",
            "command": "cmake",
            "args": ["-S", ".", "-B", "build-release", "-G", "Ninja", "-DCMAKE_BUILD_TYPE=Release"],
            "windows": {
                "args": ["-S", ".", "-B", "build-release", "-G", "Ninja", "-DCMAKE_BUILD_TYPE=Release",
                         "-DCMAKE_C_COMPILER=gcc", "-DCMAKE_CXX_COMPILER=g++"]
            },
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "Build Release",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "build-release"],
            "dependsOn": "Configure Release",
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": { "base": "$gcc", "fileLocation": ["autoDetect", "${workspaceFolder}/build-release"] }
        },
        {
            "label": "Configure MSVC",
            "type": "process",
            "command": "cmake",
            "args": ["--preset", "vs2022"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "Build MSVC Debug",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "--preset", "vs2022-debug", "--", "/m", "/v:minimal", "/nologo"],
            "dependsOn": "Configure MSVC",
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build MSVC Release",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "--preset", "vs2022-release", "--", "/m", "/v:minimal", "/nologo"],
            "dependsOn": "Configure MSVC",
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Regenerate sandbox assets",
            "type": "process",
            "command": "python3",
            "args": ["tools/generate_assets.py"],
            "windows": { "command": "python" },
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        }
    ]
}
