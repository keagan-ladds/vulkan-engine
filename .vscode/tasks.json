{
    // Build tasks used by launch.json (preLaunchTask) and Ctrl+Shift+B (Debug).
    // Each configures CMake (re-globbing new source/shader files) then builds.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Debug && cmake --build build",
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": { "base": "$gcc", "fileLocation": ["autoDetect", "${workspaceFolder}/build"] },
            // Windows: the Visual Studio generator finds the compiler itself (no developer prompt needed).
            "windows": {
                "command": "cmake -S . -B build -G 'Visual Studio 17 2022' -A x64; if ($?) { cmake --build build --config Debug }",
                "problemMatcher": "$msCompile"
            }
        },
        {
            "label": "Build Release",
            "type": "shell",
            "command": "cmake -S . -B build-release -G Ninja -DCMAKE_BUILD_TYPE=Release && cmake --build build-release",
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": { "base": "$gcc", "fileLocation": ["autoDetect", "${workspaceFolder}/build-release"] },
            "windows": {
                "command": "cmake -S . -B build-release -G 'Visual Studio 17 2022' -A x64; if ($?) { cmake --build build-release --config Release }",
                "problemMatcher": "$msCompile"
            }
        },
        {
            "label": "Regenerate sandbox assets",
            "type": "shell",
            "command": "python3 tools/generate_assets.py",
            "windows": { "command": "python tools/generate_assets.py" },
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        }
    ]
}
